#!/bin/sh

cpu_percent=$(top -l 1 -n 0 | awk '/CPU usage/ { printf "%.0f", 100 - $7 }')
vm_stats=$(vm_stat)
page_size=$(printf '%s\n' "$vm_stats" | awk 'NR == 1 { print $8 }')
total_bytes=$(sysctl -n hw.memsize)

set -- $(printf '%s\n' "$vm_stats" | awk -v page_size="$page_size" -v total_bytes="$total_bytes" '
  /Anonymous pages/ { anonymous = $3 }
  /Pages purgeable/ { purgeable = $3 }
  /Pages wired down/ { wired = $4 }
  /Pages occupied by compressor/ { compressed = $5 }
  END {
    used_bytes = (anonymous - purgeable + wired + compressed) * page_size
    printf "%.1f %.0f", used_bytes / 1073741824, total_bytes / 1073741824
  }
')

printf 'CPU %s%% · RAM %s/%sG\n' "$cpu_percent" "$1" "$2"
